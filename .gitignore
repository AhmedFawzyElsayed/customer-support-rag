# Virtual environments
.venv/
venv/
env/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Environment variables (never commit real secrets)
.env
backend/.env
frontend/.env

# Logs
*.log

# Jupyter
.ipynb_checkpoints/

# Vector store (regenerate from the notebook; remove this line if you want
# to commit a small persisted store, e.g. under 50 MB)
data/vector_store/*
!data/vector_store/.gitkeep

# OS files
.DS_Store
Thumbs.db
